# Supabase — copy to .env.local and fill in your project values
# Dashboard: https://supabase.com/dashboard/project/<project-id>/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Typesense (Issue #5)
# Example host: https://xxxxxx.a1.typesense.net
TYPESENSE_HOST=

# Server-only: admin key used for schema/index management
TYPESENSE_ADMIN_API_KEY=

# Search-only key used by server search adapter
TYPESENSE_SEARCH_API_KEY=
