# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Typesense
TYPESENSE_HOST=your-typesense-host
TYPESENSE_API_KEY=your-admin-api-key
TYPESENSE_SEARCH_API_KEY=your-search-only-api-key

# Sentry (optional — error tracking)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Resend (optional — report flag emails)
RESEND_API_KEY=re_your-api-key
REPORT_RECIPIENT_EMAIL=admin@yourdomain.com

# Vercel Cron (set by Vercel automatically, or set manually)
CRON_SECRET=your-cron-secret

# Admin auth
ADMIN_EMAIL=admin@yourdomain.com

# Beta gate (optional — set to enable closed beta, remove to go public)
BETA_ACCESS_CODE=
BETA_FEEDBACK_URL=
